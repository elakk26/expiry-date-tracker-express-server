PORT=5001
NODE_ENV=production

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expiry-date-tracker?retryWrites=true&w=majority

# JWT — generate a strong random secret (e.g., openssl rand -hex 64)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of allowed frontend origins
# Example: https://your-frontend.vercel.app,https://your-custom-domain.com
CORS_ORIGIN=
